# ---------------------------------------------------------------------------
# AInsight configuration. Copy to .env and edit. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- language model ---------------------------------------------------------
# DEMO_MODE=true runs the full pipeline with the deterministic planner and no
# external API. Analytics, validation, charts and the UI all work offline.
DEMO_MODE=true

# Used when DEMO_MODE=false. One of: openai | anthropic | gemini | local
LLM_PROVIDER=openai
MODEL_NAME=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.0

# --- storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///database/analytics.db
# ANALYTICS_DATABASE_URL=sqlite:///database/analytics.db
CHROMA_PATH=data/processed/chroma
UPLOAD_DIR=data/uploads

# --- limits -----------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_QUERY_RETRIES=2
MAX_RESULT_ROWS=5000
QUERY_TIMEOUT_SECONDS=30
RAG_TOP_K=6
MEMORY_TURNS=8

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
DEBUG=false
# Leave this off unless you're actively editing code — see app.py for why it
# can make the server appear to "shut down" when you upload a file.
RELOADER=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- accounts & sessions ----------------------------------------------------
# AUTH_REQUIRED=true: every page/API needs a signed-in account and all data is
# scoped per user. false = legacy single-user demo mode (never on a shared host).
AUTH_REQUIRED=true
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=14
# Set true on any HTTPS deployment (Render etc.); leave false for http://localhost.
COOKIE_SECURE=false
# Set true only behind exactly one trusted reverse proxy (Render, nginx).
TRUST_PROXY_HEADERS=false
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
# Public URL used in emailed links, e.g. https://ainsight.onrender.com
APP_BASE_URL=
# Extra browser origins allowed to call the API (comma separated). Native apps don't need this.
CORS_ORIGINS=
# Email that adopts data created before accounts existed.
LEGACY_DATA_OWNER_EMAIL=

# --- email (password reset / verification) ----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=AInsight <no-reply@example.com>
EMAIL_LOG_LINKS=false

# --- connectors -------------------------------------------------------------
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ALLOW_PRIVATE_NETWORK=false
CONNECTOR_ALLOW_INSECURE_HTTP=false
CONNECTOR_CONNECT_TIMEOUT=10
CONNECTOR_MAX_SOURCES_PER_USER=20
REST_MAX_RESPONSE_MB=10
REST_MAX_PAGES=20
REST_MAX_ROWS=100000
ANALYSIS_FRAME_MAX_ROWS=200000

# --- agent, model routing, cost, plans ---------------------------------------
AGENT_USE_LLM=true
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=90
AGENT_TOKEN_BUDGET=20000
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_COST_USD=0
AGENT_MAX_TOOL_RETRIES=2
FAST_MODEL=
STRONG_MODEL=
FALLBACK_PROVIDER=
FALLBACK_MODEL=
# USD per million tokens, e.g. {"gpt-4o-mini":{"input":0.15,"output":0.60}}. Unlisted models show tokens but no cost.
LLM_PRICES_JSON=
PLAN_LIMIT_FREE=50
PLAN_LIMIT_PRO=1000
PLAN_LIMIT_BUSINESS=0
ENFORCE_PLAN_LIMITS=false
